//! dep: scoop:scoop.asyncio:0.1.0

import scoop.asyncio.*
import scoop.time.Duration

suspend fun fetch(loop: EventLoop, id: Int, delayMs: Long): String {
    loop.sleep(Duration.milliseconds(delayMs))
    return f"result #${id}"
}

fun main() {
    val loop = eventLoop()
    loop.run suspend {
        val a = async<String> suspend { fetch(loop, 1, 30L) }
        val b = async<String> suspend { fetch(loop, 2, 10L) }
        println(a.await())
        println(b.await())
    }
}
